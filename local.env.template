# Rename this file to .env after extracting the local source package.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Local development authentication. Do not use these development credentials publicly.
LOCAL_AUTH_EMAIL=developer@example.com
LOCAL_AUTH_NAME=Local Analyst
LOCAL_AUTH_PASSWORD=replace-with-a-strong-local-password
LOCAL_AUTH_ROLE=admin

# MySQL 8 configuration. Docker Compose uses these values and exposes MySQL on
# localhost:3306; native development uses DATABASE_URL directly.
MYSQL_DATABASE=ai_business_analyst
MYSQL_USER=ai_analyst
MYSQL_PASSWORD=replace-with-a-strong-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-separate-strong-root-password
DATABASE_URL=mysql://ai_analyst:replace-with-a-strong-local-database-password@127.0.0.1:3306/ai_business_analyst
STORAGE_DIR=./data/uploads

# OpenAI-compatible LLM service. Leave LLM_API_KEY blank to use deterministic
# SQL-backed fallback analysis without model planning or enrichment.
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
